~# Webasto LoRa Remote Control - Device Port Aliases
# Installation: 
#   sudo cp 99-webasto-devices.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Note: all CP2102 boards report the same serial number (0001), so only the USB port
# path (ATTRS{devpath}) tells them apart.
# They are distinguished by USB port path (ATTR{devpath}).
# If you move devices to different USB ports, you'll need to update these rules.

# ESP32 W-BUS Simulator (CP2102 on USB port 1.2)
# Use: udevadm info -q all -n /dev/ttyUSBx | grep DEVPATH to verify port
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{devpath}=="1.2", SYMLINK+="ttyWEBASTOSIM", MODE="0666", GROUP="uucp"

# Sender Device (CP2102 on USB port 1.1)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{devpath}=="1.1", SYMLINK+="ttyWEBASTOSEND", MODE="0666", GROUP="uucp"

# Receiver Device (CP2102 on USB port 1.4)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{devpath}=="1.4", SYMLINK+="ttyWEBASTORECV", MODE="0666", GROUP="uucp"

# CAN sniffer (LOLIN ESP32-S2 mini, native USB CDC). Matches by USB ID, any port.
# The ROM bootloader (303a:0002) is not matched; flash via /dev/ttyACM* then.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="80c2", SYMLINK+="ttyCANSNIFF", MODE="0666", GROUP="uucp"
